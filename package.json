{
  "name": "webdrop",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run -w @webdrop/web dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint web server eslint.config.ts --max-warnings 0",
    "test": "npm run test -w @webdrop/web",
    "fmt": "npm run lint -- --fix",
    "server-dev": "npm run dev --workspace=@webdrop/server"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
