{
  "name": "webdrop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @webdrop/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint web server eslint.config.ts --max-warnings 0",
    "test": "npm run test -w @webdrop/web",
    "fmt": "npm run lint -- --fix",
    "build-server": "npm run build -w @webdrop/server",
    "serve-dev": "./scripts/serve-dev.sh"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
